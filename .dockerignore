# Build artifacts and caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local virtual environment — never needed inside the image.
.venv/
venv/
env/

# Local runtime data is mounted as a volume, not baked into the image.
data/

# Editor / OS clutter.
.git/
.gitignore
.env
.env.example
.idea/
.vscode/
.DS_Store

# Docs and tests are not needed at runtime.
docs/
tests/
README.md
