# Local environment — never needed inside the image.
.venv/

# Local runtime data is mounted as a volume, not baked into the image.
data/
.audit/
.slim/
.openapi-data/
.github/
.opencode/
.ignore
AGENTS.md
CONTEXT.md

# Editor / OS clutter.
.git/
.gitignore
.env
.env.example
.idea/
.vscode/
.DS_Store

# Docs and tests are not needed at runtime.
docs/
tests/
frontend/e2e/
**/*_test.go
frontend/**/*.test.ts
frontend/**/*.test.tsx
README.md
