# Discord bot authentication token.
DISCORD_TOKEN=

# LLM provider — must match a provider ID known to OpenCode (see
# https://opencode.ai/docs/providers/). The default `opencode` is OpenCode
# Zen (https://opencode.ai/docs/zen/). Set to `custom-llm` to use a custom
# OpenAI-compatible endpoint via the legacy shim (requires LLM_BASE_URL).
LLM_PROVIDER=opencode

# API key for the LLM provider. The bot maps this to the right env var at
# startup (e.g. OPENCODE_API_KEY for `opencode`, ANTHROPIC_API_KEY for
# `anthropic`, OPENAI_API_KEY for `openai`). For providers that don't use
# API keys (github-copilot, google-vertex, amazon-bedrock), run
# `opencode auth login` once on the host or set the appropriate env vars
# yourself.
LLM_API_KEY=

# Model name (without the provider prefix). Examples:
#   opencode provider: deepseek-v4-flash-free, claude-sonnet-4-5, gpt-5
#   anthropic provider: claude-sonnet-4-5, claude-opus-4-5
#   openai provider: gpt-5, gpt-5.1-codex
# Use `opencode models` to list what's available for the auth'd provider.
LLM_MODEL=deepseek-v4-flash-free

# Optional reasoning-effort variant (model-specific). Examples: max, high,
# low, minimal, medium. Leave unset to use the model's default. List valid
# variants for a model with `opencode models --verbose`.
# LLM_VARIANT=max

# Optional overrides for the AGENT.md generator (the background task that
# preprocesses each cloned repo and produces its AGENT.md). When unset,
# these default to the corresponding LLM_* values above. Use these to
# route the generator through a different provider/model — e.g. a cheap
# fast model for repo preprocessing while the answering flow uses a
# stronger model.
# AGENT_MD_PROVIDER=opencode
# AGENT_MD_MODEL=deepseek-v4-flash-free
# AGENT_MD_VARIANT=low

# Base URL of a custom OpenAI-compatible LLM endpoint. ONLY required when
# LLM_PROVIDER=custom-llm. Ignored otherwise.
# LLM_BASE_URL=https://api.example.com/v1

# GitHub token used to authenticate when cloning/pulling private repositories (optional).
# Will be automatically injected into https://github.com/... URLs.
# GITHUB_TOKEN=

# Comma-separated list (or JSON array) of git repository URLs to clone
# and compile into the full-context documentation. Example:
#   REPO_URLS=https://github.com/example/repo1.git,https://github.com/example/repo2.git
#   REPO_URLS=["https://github.com/example/repo1.git","https://github.com/example/repo2.git"]
REPO_URLS=

# Interval (in minutes) between repository polling for upstream changes.
POLL_INTERVAL_MINUTES=10

# opencode server (long-lived subprocess started by the bot)
OPENCODE_SERVER_HOST=127.0.0.1
OPENCODE_SERVER_PORT=4096
# Leave OPENCODE_SERVER_PASSWORD unset to auto-generate a secure random
# password at startup. Set it explicitly to keep the same password across
# bot restarts (useful for attaching via `opencode web` for debugging).
# OPENCODE_SERVER_PASSWORD=

# Per-user session TTL in minutes. After this idle period, the user's
# session is deleted and a fresh one is created on the next message.
SESSION_TTL_MINUTES=30
