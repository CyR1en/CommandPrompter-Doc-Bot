# Discord bot authentication token.
DISCORD_TOKEN=

# API key for the OpenAI-compatible LLM provider.
LLM_API_KEY=

# Base URL of the OpenAI-compatible LLM endpoint.
LLM_BASE_URL=

# Model name to use for LLM chat generation.
LLM_MODEL=gpt-3.5-turbo

# GitHub token used to authenticate when cloning/pulling private repositories (optional).
# Will be automatically injected into https://github.com/... URLs.
# GITHUB_TOKEN=

# Comma-separated list (or JSON array) of git repository URLs to clone
# and compile into the full-context documentation. Example:
#   REPO_URLS=https://github.com/example/repo1.git,https://github.com/example/repo2.git
#   REPO_URLS=["https://github.com/example/repo1.git","https://github.com/example/repo2.git"]
REPO_URLS=

# Interval (in minutes) between repository polling for upstream changes.
POLL_INTERVAL_MINUTES=10
