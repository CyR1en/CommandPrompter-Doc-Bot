# Copy to .env and replace every example credential before deployment.
COMPOSE_PROJECT_NAME=ref0
POSTGRES_DB=ref0
POSTGRES_USER=ref0
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=5432
API_PORT=8000
PUBLIC_ORIGIN=http://localhost:8000
METRICS_BEARER_TOKEN=replace-with-a-random-metrics-bearer-token

# Format: key-id:base64url-of-exactly-32-bytes. This is a format example,
# not a production key. Keep the matching key with every backup.
APP_MASTER_KEY=example-v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
APP_PREVIOUS_MASTER_KEYS=

# Remove this value after the first operator bootstrap succeeds.
APP_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-bootstrap-token
BOOTSTRAP_TOKEN_TTL_MINUTES=30
OPERATOR_SESSION_TTL_MINUTES=10080

APP_DATA_DIR=/app/data
APP_VERSION=0.1.0
# Local Compose builds tag these names. Release deployments must replace both
# with release-qualified GHCR tags or immutable digests.
REF0_IMAGE=ref0:local
REF0_CAPSULE_IMAGE=ref0-pi-capsule:pi-0.84.4-r9
DOCUMENTATION_AGENT_RUNTIME=pi-capsule
PI_CAPSULE_SOCKET_PATHS=["/run/capsule-slot-0/capsule.sock","/run/capsule-slot-1/capsule.sock"]
SOURCE_ALLOW_PRIVATE_NETWORK=false
# SOURCE_GIT_CA_FILE=/app/config/source-git-ca.pem
SOURCE_GIT_CA_FILE=
SOURCE_POLL_SCAN_SECONDS=30
SOURCE_POLL_BATCH_SIZE=50
KNOWLEDGE_BASE_DELETE_GRACE_HOURS=72

WORKER_ID=worker-1
JOB_LEASE_SECONDS=60
JOB_POLL_INTERVAL_SECONDS=1
JOB_RETRY_BACKOFF_SECONDS=5

# The worker schedules one fenced cleanup job per scan. Each policy is the
# minimum age before eligible, unreferenced data can be removed.
RETENTION_SCAN_SECONDS=3600
RETENTION_BATCH_SIZE=100
SOURCE_SNAPSHOT_RETENTION_DAYS=30
FAILED_DRAFT_RETENTION_DAYS=14
JOB_LOG_RETENTION_DAYS=30
EVENT_LOG_RETENTION_DAYS=30
AGENT_RUN_RETENTION_DAYS=90
DISCORD_CONTEXT_RETENTION_DAYS=7
OLD_WIKI_RETENTION_DAYS=90

# Discord tokens are entered and rotated in the authenticated dashboard.
# They are encrypted in PostgreSQL and are never environment variables.
DISCORD_SUPERVISOR_SCAN_SECONDS=2
DISCORD_CONTEXT_IDLE_MINUTES=30
