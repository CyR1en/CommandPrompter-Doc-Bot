{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ref0.invalid/pi-capsule/wire.schema.json",
  "title": "Pi capsule private wire message",
  "oneOf": [
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/tool_result" },
    { "$ref": "#/$defs/model_result" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/tool_call" },
    { "$ref": "#/$defs/model_request" },
    { "$ref": "#/$defs/complete" },
    { "$ref": "#/$defs/failed" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "max_aggregate_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 33554432
        },
        "max_string_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 2097152
        },
        "max_depth": { "type": "integer", "minimum": 4, "maximum": 64 },
        "max_keys": { "type": "integer", "minimum": 32, "maximum": 100000 },
        "max_fetch_body_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "max_fetches": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_model_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "max_frame_bytes",
        "max_aggregate_bytes",
        "max_string_bytes",
        "max_depth",
        "max_keys",
        "max_fetch_body_bytes",
        "max_fetches",
        "max_model_requests"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "model_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "body_options": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
            "frequency_penalty": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "presence_penalty": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "seed": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "stop": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          },
          "additionalProperties": false
        },
        "reasoning_effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "max"]
        },
        "context_window": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "capsule_runtime_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "model_id",
        "body_options",
        "reasoning_effort",
        "context_window",
        "max_output_tokens",
        "timeout_ms",
        "capsule_runtime_revision"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 4096 },
        "parameters": { "type": "object" }
      },
      "required": ["name", "description", "parameters"],
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "properties": {
        "type": { "const": "start" },
        "protocol_version": { "const": 1 },
        "attempt_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["PLANNER", "PAGE_WRITER"] },
        "system_prompt": { "type": "string" },
        "prompt": { "type": "string" },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/tool" }
        },
        "output_schema": { "type": "object" },
        "provider": { "$ref": "#/$defs/provider" },
        "limits": { "$ref": "#/$defs/limits" }
      },
      "required": [
        "type",
        "protocol_version",
        "attempt_id",
        "role",
        "system_prompt",
        "prompt",
        "tools",
        "output_schema",
        "provider",
        "limits"
      ],
      "additionalProperties": false
    },
    "tool_result": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_result" },
        "id": { "$ref": "#/$defs/id" },
        "result": {},
        "content": { "type": "string" }
      },
      "required": ["type", "id", "result", "content"],
      "additionalProperties": false
    },
    "model_result": {
      "type": "object",
      "properties": {
        "type": { "const": "model_result" },
        "id": { "$ref": "#/$defs/id" },
        "body_base64": { "type": "string" }
      },
      "required": ["type", "id", "body_base64"],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "type": { "const": "cancel" },
        "reason": { "type": "string", "maxLength": 256 }
      },
      "required": ["type", "reason"],
      "additionalProperties": false
    },
    "tool_call": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_call" },
        "id": { "$ref": "#/$defs/id" },
        "provider_call_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "arguments": { "type": "object" }
      },
      "required": ["type", "id", "provider_call_id", "name", "arguments"],
      "additionalProperties": false
    },
    "model_request": {
      "type": "object",
      "properties": {
        "type": { "const": "model_request" },
        "id": { "$ref": "#/$defs/id" },
        "turn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": ["type", "id", "turn"],
      "additionalProperties": false
    },
    "complete": {
      "type": "object",
      "properties": {
        "type": { "const": "complete" },
        "output": { "type": "object" }
      },
      "required": ["type", "output"],
      "additionalProperties": false
    },
    "failed": {
      "type": "object",
      "properties": {
        "type": { "const": "failed" },
        "code": {
          "enum": [
            "cancelled",
            "protocol",
            "provider",
            "tool",
            "invalid_result",
            "internal"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 }
      },
      "required": ["type", "code", "message"],
      "additionalProperties": false
    }
  }
}
